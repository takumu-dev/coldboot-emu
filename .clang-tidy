# SPDX-License-Identifier: GPL-3.0-or-later
---
# The broad groups, with every warning an error, less the checks that cost more than they catch.
# A finding that has to stand is suppressed with `NOLINT(<check>): <reason>`, never a bare NOLINT.
Checks:
  - -*
  - bugprone-*
  - clang-analyzer-*
  - concurrency-*
  - cppcoreguidelines-*
  - misc-*
  - modernize-*
  - performance-*
  - portability-*
  - readability-*
  - -bugprone-easily-swappable-parameters
  - -cppcoreguidelines-avoid-magic-numbers
  # Bounds are checked by _GLIBCXX_ASSERTIONS and the sanitizers, and guest indices are masked.
  - -cppcoreguidelines-pro-bounds-constant-array-index
  # The same, for containers: `at()` throws, and the core builds without exceptions.
  - -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access
  # -Wunsafe-buffer-usage covers pointer arithmetic.
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -modernize-use-trailing-return-type
  # Headers use #pragma once, which Clang understands.
  - -portability-avoid-pragma-once
  - -readability-identifier-length
  - -readability-magic-numbers
  # A plain struct gives each member an initialiser, so that a designated initialiser may leave any
  # of them out without -Wmissing-field-initializers, and this calls `{}` on a class redundant.
  - -readability-redundant-member-init
WarningsAsErrors: '*'
# The project's own headers. Third-party headers come in as system headers, which are never checked.
HeaderFilterRegex: '/(include|src|tests)/'
ExcludeHeaderFilterRegex: '/vcpkg_installed/'
CheckOptions:
  # PascalCase types, concepts, aliases and template parameters.
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.UnionCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.ConceptCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.ValueTemplateParameterCase: CamelCase
  readability-identifier-naming.TemplateTemplateParameterCase: CamelCase
  # snake_case for everything else, with no prefix on constants.
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.FunctionCase: lower_case
  readability-identifier-naming.MethodCase: lower_case
  readability-identifier-naming.VariableCase: lower_case
  readability-identifier-naming.ParameterCase: lower_case
  readability-identifier-naming.MemberCase: lower_case
  readability-identifier-naming.ConstexprVariableCase: lower_case
  readability-identifier-naming.EnumConstantCase: lower_case
  readability-identifier-naming.ScopedEnumConstantCase: lower_case
  # A trailing underscore on private and protected data members; plain struct fields are bare.
  readability-identifier-naming.PrivateMemberSuffix: _
  readability-identifier-naming.ProtectedMemberSuffix: _
  # Macros only where nothing else will do, in upper case.
  readability-identifier-naming.MacroDefinitionCase: UPPER_CASE
  readability-identifier-naming.IgnoreMainLikeFunctions: true
  # A plain struct, its fields all public, may still have member functions such as operators.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
...
